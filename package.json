{
  "name": "swirl-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start": "node server/src/index.js",
    "build": "npm run build --workspace=client",
    "client": "npm run dev --workspace=client",
    "client:build": "npm run build --workspace=client",
    "client:test": "npm test --workspace=client",
    "server": "node server/src/index.js",
    "server:dev": "npm run dev --workspace=server",
    "server:test": "npm test --workspace=server",
    "test": "npm run client:test && npm run server:test",
    "audit:check": "npm audit --audit-level=high",
    "seed:fetch": "node server/scripts/fetchSeedData.js"
  }
}
